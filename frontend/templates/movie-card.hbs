<div class="card h-100 bg-black text-light border border-secondary">
  {{#if poster_url}}
    <img
      src="{{poster_url}}"
      alt="Poster for {{title}}"
      class="card-img-top object-fit-cover"
      style="height: 320px"
    />
  {{/if}}
  <div class="card-body d-flex flex-column">
    <h3 class="h5 card-title">{{title}}</h3>
    <p class="text-secondary small">{{detailsLine}}</p>
    <p class="card-text flex-grow-1">{{descriptionText}}</p>
    {{#if badgeText}}
      <span class="badge bg-warning text-dark align-self-start">{{badgeText}}</span>
    {{/if}}
    <div class="d-grid gap-2 mt-3">
      <button
        type="button"
        class="btn btn-outline-light btn-sm"
        data-action="detail"
        data-movie-id="{{id}}"
      >
        View details
      </button>
      <button
        type="button"
        class="btn btn-sm {{#if saved}}btn-outline-danger{{else}}btn-outline-light{{/if}}"
        data-movie-id="{{id}}"
        data-action="watchlist"
        data-watchlist-action="{{#if saved}}remove{{else}}add{{/if}}"
        {{#if saved_movie_id}}data-saved-movie-id="{{saved_movie_id}}"{{/if}}
        {{#if imdb_id}}data-imdb-id="{{imdb_id}}"{{/if}}
        {{#unless canSave}}disabled{{/unless}}
      >
        {{#if saved}}Remove from watchlist{{else}}Add to watchlist{{/if}}
      </button>
    </div>
  </div>
  <div class="card-footer bg-transparent border-top border-secondary">
    {{runtimeText}}
  </div>
</div>
